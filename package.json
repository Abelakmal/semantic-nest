{
  "name": "nest-cli-custom",
  "version": "2.0.1",
  "description": "A CLI tool to generate TypeORM repositories for NestJS projects",
  "author": "Abel Akmal",
  "license": "MIT",
  "main": "dist/cli.js",
  "bin": {
    "nax": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@nestjs/platform-express": "^11.0.10",
    "nest-commander": "^3.15.0",
    "pluralize": "^8.0.0"
  },
  "peerDependencies": {
    "@nestjs/common": "^10.0.0 || ^11.0.0",
    "@nestjs/core": "^10.0.0 || ^11.0.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": {
      "optional": true
    },
    "@nestjs/core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@angular-devkit/core": "^16.1.4",
    "@angular-devkit/schematics": "^16.1.4",
    "@eslint/js": "^9.21.0",
    "@nestjs/schematics": "^9.0.0",
    "@types/pluralize": "^0.0.33",
    "eslint": "^9.21.0",
    "ts-node": "^10.9.1",
    "typescript": "^4.9.5",
    "typescript-eslint": "^8.25.0"
  }
}
